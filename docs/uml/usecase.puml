@startuml
left to right direction

actor User

rectangle "COLORS Web Application" {
  usecase "Log In" as UC1
  usecase "Add Color" as UC2
  usecase "Search Colors" as UC3
  usecase "Log Out" as UC4
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4

UC2 ..> UC1 : requires login
UC3 ..> UC1 : requires login
UC4 ..> UC1 : requires login

@enduml
